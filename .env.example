# ========================
# SUPABASE CONFIGURATION
# ========================
# From Supabase Dashboard > Settings > API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ========================
# STRIPE CONFIGURATION
# ========================
# Publishable key only - Secret key goes in Supabase Edge Function secrets
# From Stripe Dashboard > Developers > API Keys (toggle to Live)
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_your_publishable_key_here

# ========================
# SUPABASE EDGE FUNCTION SECRETS
# ========================
# Configure these in Supabase Dashboard > Edge Functions > Secrets
# DO NOT put these in this file - they must be set server-side only

# From Stripe Dashboard > Developers > API Keys (toggle to Live)
# STRIPE_SECRET_KEY=sk_live_your_secret_key_here

# From Stripe Dashboard > Developers > Webhooks (Signing secret)
# STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Supabase service role key (from Settings > API)
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ========================
# STORE INFORMATION
# ========================
# Used in emails and invoices
# STORE_NAME=Tralalá Criativo
# STORE_STREET=Rua Exemplo, 123
# STORE_CITY=Lisboa
# STORE_ZIP=1000-001
# STORE_PHONE=+351910000000
# STORE_EMAIL=geral@tralalacriativo.pt

# ========================
# SHIPPING PROVIDER
# ========================
# Shippo API key (if using shipment tracking)
# SHIPPO_API_KEY=shippo_live_your_key_here
