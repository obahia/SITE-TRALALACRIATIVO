# SUPABASE CONFIG
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# STRIPE CONFIG (publishable key only - secret key goes in Supabase Edge Function secrets)
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_your_key

# SUPABASE EDGE FUNCTION SECRETS (configure in Supabase Dashboard > Edge Functions > Secrets)
# STRIPE_SECRET_KEY=sk_live_your_key
# STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
# SHIPPO_API_KEY=shippo_live_your_key
